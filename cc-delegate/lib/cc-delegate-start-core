#!/usr/bin/env bash
# cc-delegate-start-core — shared implementation for the cc-delegate-start-* wrappers.
# Do not invoke directly from SKILL.md; use the bin/cc-delegate-start-* wrappers instead.
#
# Usage: cc-delegate-start-core --mode {cc|cc-plan|codex|raw} [--cwd DIR] [--no-nonce]
#                               [--workspace REF|ID] [--model NAME]
# Prompt is read from stdin.
#
# Modes:
#   cc          Launch `claude`.
#               Appends a completion-sentinel nonce to the prompt.
#   cc-plan     Launch `claude --permission-mode plan`.
#               Appends a completion-sentinel nonce to the prompt.
#   codex       Launch `codex` (Codex CLI).
#               Appends a completion-sentinel nonce to the prompt.
#   raw         Skip the cc launch entirely. Stdin is pasted verbatim into a fresh
#               shell prompt and Enter is hit — fire-and-forget shell command.
#               No nonce. Do not follow up with cc-delegate-send.
#
# --no-nonce (cc/cc-plan/codex): paste and submit the prompt verbatim — no
# sentinel appended, no nonce= line printed. Needed for slash-command
# prompts, which the appended sentinel would stop being treated as commands.
# No-op in raw mode (already nonce-free).
#
# --workspace REF|ID: open the tab in this workspace (workspace:N, or the
# UUID from `cmux workspace list --json`). Default: the shared
# "Claude_cc-delegate" workspace (bin/cc-delegate-workspace creates it at the
# bottom of the sidebar when missing).
#
# --cwd DIR: directory the tab starts in. Default: the calling shell's own
# directory ($PWD).
#
# --model NAME (cc/cc-plan/codex): append `--model NAME` to the launched command.
# Error in raw mode — no sub-session is launched there, so it can't take effect.
#
# On success, prints to stdout:
#   ws_ref=workspace:N
#   surface_ref=surface:M
#   nonce=CC_DELEGATE_DONE_<rand>   (omitted in raw mode and with --no-nonce)

set -euo pipefail

CWD=""
MODE=""
MODEL=""
WORKSPACE=""
NONCE_MODE=1
while [ $# -gt 0 ]; do
    case "$1" in
        --no-nonce)
            NONCE_MODE=0
            shift
            ;;
        --cwd)
            if [ $# -lt 2 ]; then
                echo "ERROR: --cwd requires a directory argument" >&2
                exit 1
            fi
            CWD="$2"
            shift 2
            ;;
        --mode)
            if [ $# -lt 2 ]; then
                echo "ERROR: --mode requires a value (cc|cc-plan|codex|raw)" >&2
                exit 1
            fi
            MODE="$2"
            shift 2
            ;;
        --workspace)
            if [ $# -lt 2 ]; then
                echo "ERROR: --workspace requires a workspace ref or id" >&2
                exit 1
            fi
            WORKSPACE="$2"
            shift 2
            ;;
        --model)
            if [ $# -lt 2 ]; then
                echo "ERROR: --model requires a model name" >&2
                exit 1
            fi
            MODEL="$2"
            shift 2
            ;;
        --help|-h)
            sed -n '2,39p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

case "$MODE" in
    cc|cc-plan|codex|raw) ;;
    "") echo "ERROR: --mode is required (cc|cc-plan|codex|raw)" >&2; exit 1 ;;
    *)  echo "ERROR: invalid --mode: $MODE (expected cc|cc-plan|codex|raw)" >&2; exit 1 ;;
esac

if [ "$MODE" = "raw" ] && [ -n "$MODEL" ]; then
    echo "ERROR: --model has no effect in raw mode (raw mode launches no sub-session)" >&2
    exit 1
fi

if ! cmux list-workspaces >/dev/null 2>&1; then
    echo "ERROR: cmux is not running (cmux list-workspaces failed)" >&2
    exit 1
fi

if [ -n "$WORKSPACE" ]; then
    ws_ref=$(CMUX_QUIET=1 cmux workspace list --json \
        | jq -r --arg q "$WORKSPACE" 'first(.workspaces[] | select(.id == $q or .ref == $q) | .ref)')
    if [ -z "$ws_ref" ]; then
        echo "ERROR: --workspace $WORKSPACE matched no workspace ref or id in cmux workspace list --json" >&2
        exit 1
    fi
else
    ws_ref=$("$(dirname "$0")/../bin/cc-delegate-workspace")
fi

# Default to where the caller is: the shared workspace's own directory means
# nothing to it.
CWD="${CWD:-$PWD}"

surface_output=$(cmux new-surface --workspace "$ws_ref")
surface_ref=$(printf '%s\n' "$surface_output" | awk '{for (i=1; i<=NF; i++) if ($i ~ /^surface:/) { print $i; exit }}')
if [ -z "${surface_ref:-}" ]; then
    echo "ERROR: could not parse surface ref from: $surface_output" >&2
    exit 1
fi

cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "cd '${CWD}'"'\n' >/dev/null
sleep 2

# Single-quoted in the spawned shell: a name like opus[1m] would otherwise
# be globbed by zsh.
MODEL_ARG=""
if [ -n "$MODEL" ]; then
    MODEL_ARG=" --model '${MODEL}'"
fi

case "$MODE" in
    cc)
        cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "claude${MODEL_ARG}"'\n' >/dev/null
        sleep 6
        ;;
    cc-plan)
        cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "claude --permission-mode plan${MODEL_ARG}"'\n' >/dev/null
        sleep 6
        ;;
    codex)
        cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "codex${MODEL_ARG}"'\n' >/dev/null
        sleep 6
        ;;
    raw)
        ;;
esac

SEND="$(dirname "$0")/../bin/cc-delegate-send"

echo "ws_ref=$ws_ref"
echo "surface_ref=$surface_ref"

if [ "$MODE" = "raw" ]; then
    "$SEND" --no-nonce --shell "$ws_ref" "$surface_ref"
elif [ "$NONCE_MODE" -eq 0 ]; then
    "$SEND" --no-nonce "$ws_ref" "$surface_ref"
else
    "$SEND" "$ws_ref" "$surface_ref"
fi
