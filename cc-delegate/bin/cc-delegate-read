#!/usr/bin/env bash
# cc-delegate-read — read the scrollback of a cc-delegate sub-session.
# Usage: cc-delegate-read <ws_ref> <surface_ref> [--wait-for NONCE] [--close]
#
# Without --wait-for: reads scrollback once and exits.
# With --wait-for: polls every 5s for the nonce to appear at least twice in the
#   buffer (once from the pasted prompt, once from sub-cc's reply). Times out
#   after ~9 min and exits 2. During timeout, prints whatever scrollback it has.
# With --close: closes the tab after reading.

set -euo pipefail

WAIT_FOR=""
CLOSE=0
WS_REF=""
SURFACE_REF=""

while [ $# -gt 0 ]; do
    case "$1" in
        --wait-for)
            if [ $# -lt 2 ]; then
                echo "ERROR: --wait-for requires a nonce argument" >&2
                exit 1
            fi
            WAIT_FOR="$2"
            shift 2
            ;;
        --close)
            CLOSE=1
            shift
            ;;
        --help|-h)
            sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        -*)
            echo "ERROR: unknown flag: $1" >&2
            exit 1
            ;;
        *)
            if [ -z "$WS_REF" ]; then
                WS_REF="$1"
            elif [ -z "$SURFACE_REF" ]; then
                SURFACE_REF="$1"
            else
                echo "ERROR: unexpected positional argument: $1" >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [ -z "$WS_REF" ] || [ -z "$SURFACE_REF" ]; then
    echo "Usage: cc-delegate-read <ws_ref> <surface_ref> [--wait-for NONCE] [--close]" >&2
    exit 1
fi

if [ -n "$WAIT_FOR" ]; then
    MAX_ITERATIONS=108  # 108 * 5s = 9 min
    i=0
    while [ $i -lt $MAX_ITERATIONS ]; do
        count=$(cmux read-screen --workspace "$WS_REF" --surface "$SURFACE_REF" --scrollback 2>/dev/null | grep -cF "$WAIT_FOR" || true)
        if [ "${count:-0}" -ge 2 ]; then
            break
        fi
        sleep 5
        i=$((i+1))
    done
    if [ $i -ge $MAX_ITERATIONS ]; then
        echo "ERROR: timed out after 9 minutes waiting for nonce $WAIT_FOR" >&2
        cmux read-screen --workspace "$WS_REF" --surface "$SURFACE_REF" --scrollback
        exit 2
    fi
fi

cmux read-screen --workspace "$WS_REF" --surface "$SURFACE_REF" --scrollback

if [ $CLOSE -eq 1 ]; then
    cmux send-key --workspace "$WS_REF" --surface "$SURFACE_REF" ctrl+c >/dev/null 2>&1 || true
    sleep 1
    cmux send-key --workspace "$WS_REF" --surface "$SURFACE_REF" ctrl+c >/dev/null 2>&1 || true
    sleep 1
    cmux close-surface --workspace "$WS_REF" --surface "$SURFACE_REF" >/dev/null
fi
