#!/usr/bin/env bash
# cc-delegate-start — open a new cmux tab, paste input, hit Enter (launches cc by default; --raw skips it).
# Usage: cc-delegate-start [--cwd DIR] [--raw]
# Prompt is read from stdin.
#
# On success, prints to stdout:
#   ws_ref=workspace:N
#   surface_ref=surface:M
#   nonce=CC_DELEGATE_DONE_<rand>   (omitted in --raw mode)
# The caller uses ws_ref + surface_ref for subsequent cc-delegate-read / -send calls.
#
# Without --raw: launches `cc` in the new tab, appends a completion-sentinel
# nonce to the prompt, pastes, and hits Enter. The nonce enables
# `cc-delegate-read --wait-for $nonce`.
#
# With --raw: skips the `cc` launch and the nonce. stdin is pasted verbatim
# into a fresh shell prompt and Enter is hit — fire-and-forget shell command.
# Do not follow up with `cc-delegate-send` (it appends a cc-only sentinel).

set -euo pipefail

CWD=""
RAW=0
while [ $# -gt 0 ]; do
    case "$1" in
        --cwd)
            if [ $# -lt 2 ]; then
                echo "ERROR: --cwd requires a directory argument" >&2
                exit 1
            fi
            CWD="$2"
            shift 2
            ;;
        --raw)
            RAW=1
            shift
            ;;
        --help|-h)
            sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

if ! cmux list-workspaces >/dev/null 2>&1; then
    echo "ERROR: cmux is not running (cmux list-workspaces failed)" >&2
    exit 1
fi

ws_ref=$(cmux list-workspaces | awk '/\[selected\]/ {print $2; exit}')
if [ -z "${ws_ref:-}" ]; then
    echo "ERROR: could not find selected workspace in cmux list-workspaces output" >&2
    exit 1
fi

surface_output=$(cmux new-surface --workspace "$ws_ref")
surface_ref=$(printf '%s\n' "$surface_output" | awk '{for (i=1; i<=NF; i++) if ($i ~ /^surface:/) { print $i; exit }}')
if [ -z "${surface_ref:-}" ]; then
    echo "ERROR: could not parse surface ref from: $surface_output" >&2
    exit 1
fi

if [ -n "$CWD" ]; then
    cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "cd ${CWD}"'\n' >/dev/null
    sleep 2
fi

if [ "$RAW" -eq 0 ]; then
    cmux send --workspace "$ws_ref" --surface "$surface_ref" -- 'cc\n' >/dev/null
    sleep 3
fi

PROMPT=$(cat)

if [ "$RAW" -eq 0 ]; then
    NONCE="CC_DELEGATE_DONE_$(openssl rand -hex 6)"
    PROMPT="${PROMPT}

When you have finished answering, print exactly this string on its own final line (nothing else on that line): ${NONCE}"
fi

cmux send --workspace "$ws_ref" --surface "$surface_ref" -- "$PROMPT" >/dev/null

if ! cmux send-key --workspace "$ws_ref" --surface "$surface_ref" enter >/dev/null 2>&1; then
    if ! cmux send-key --workspace "$ws_ref" --surface "$surface_ref" return >/dev/null 2>&1; then
        echo "ERROR: could not send Enter/Return to surface $surface_ref" >&2
        exit 1
    fi
fi

echo "ws_ref=$ws_ref"
echo "surface_ref=$surface_ref"
if [ "$RAW" -eq 0 ]; then
    echo "nonce=$NONCE"
fi
