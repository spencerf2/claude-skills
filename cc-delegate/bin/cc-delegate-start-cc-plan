#!/usr/bin/env bash
# cc-delegate-start-cc-plan — open a new cmux tab and launch
# `claude --permission-mode plan`. Prompt is read from stdin.
# --no-nonce pastes and submits the prompt verbatim, for slash-command
# prompts: no completion sentinel appended, no nonce= line printed.
# Thin wrapper around lib/cc-delegate-start-core --mode cc-plan.
exec "$(dirname "$0")/../lib/cc-delegate-start-core" --mode cc-plan "$@"
