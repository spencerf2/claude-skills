#!/usr/bin/env bash
# cc-delegate-read-wait — wait for the sub-session's answer, then print it.
# Usage: cc-delegate-read-wait <ws_ref> <surface_ref> <nonce>
# Polls every 5s for the answer in the sub-session's Claude Code transcript or
# Codex session file. Times out after ~9 min.
exec "$(dirname "$0")/../lib/cc-delegate-read-core" --mode read-wait "$@"
